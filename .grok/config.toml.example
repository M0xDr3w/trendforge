# Safe template — copy structure manually into .grok/config.toml (gitignored).
# NEVER paste real CLIENT_ID / CLIENT_SECRET here.

# --- Recommended: wrapper script (works in Cursor without env expansion) ---
[mcp_servers.xapi]
command = "/Users/YOUR_USER/projects/trendforge/scripts/xapi-mcp.sh"
args = []
enabled = true
startup_timeout_sec = 60

# --- Alternative: npx + env refs (only if Grok inherits your shell env) ---
# [mcp_servers.xapi]
# command = "npx"
# args = ["-y", "@xdevplatform/xurl", "mcp", "--app", "xapi"]
# enabled = true
# startup_timeout_sec = 60
#
# [mcp_servers.xapi.env]
# CLIENT_ID = "${X_CLIENT_ID}"
# CLIENT_SECRET = "${X_CLIENT_SECRET}"